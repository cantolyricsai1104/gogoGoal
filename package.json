{
  "name": "go-go-goal",
  "version": "1.0.0",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "ai:server": "node --env-file-if-exists=.env.local server/ai-server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts && node --test server/**/*.test.mjs",
    "check:safe-area": "node scripts/check-safe-area.mjs",
    "check:expo-go": "sh scripts/check-expo-go-notifications.sh"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~57.0.11",
    "expo-file-system": "~57.0.2",
    "expo-image-picker": "~57.0.8",
    "expo-notifications": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "~19.2.2",
    "tsx": "^4.23.11",
    "typescript": "~6.0.3"
  }
}
