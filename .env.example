# Copy this file to .env.local. Never commit the real API key.
GEMINI_API_KEY=replace-with-your-google-ai-studio-key
GEMINI_MODEL=gemini-3.1-flash-lite

# Android Emulator reaches the host machine at 10.0.2.2.
# For iOS Simulator, use http://127.0.0.1:8787/go-go-goal instead.
EXPO_PUBLIC_GO_GOAL_AI_URL=http://10.0.2.2:8787/go-go-goal

# Production Expo builds use the public HTTPS URL of the deployed backend.
# EXPO_PUBLIC_GO_GOAL_AI_URL=https://your-service.onrender.com/go-go-goal
