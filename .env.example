# Copy this file to .env.local. Never commit the real API key.
GEMINI_API_KEY=replace-with-your-google-ai-studio-key
GEMINI_MODEL=gemini-3.1-flash-lite

# Default: Gemini Developer API using the API key above.
GO_GOAL_AI_PROVIDER=gemini

# Vertex AI uses Google Cloud application-default credentials instead of an
# API key. Set these variables and run `gcloud auth application-default login`
# locally. For Cloud Run, grant its service account the Vertex AI User role.
# GO_GOAL_AI_PROVIDER=vertex
# GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
# GOOGLE_CLOUD_LOCATION=global
# VERTEX_AI_MODEL=gemini-2.5-flash

# Android Emulator reaches the host machine at 10.0.2.2.
# For iOS Simulator, use http://127.0.0.1:8787/go-go-goal instead.
EXPO_PUBLIC_GO_GOAL_AI_URL=http://10.0.2.2:8787/go-go-goal

# The Cloud Run service is private. Start `gcloud run services proxy` locally,
# then point the web app at the authenticated local proxy:
# EXPO_PUBLIC_GO_GOAL_AI_URL=http://127.0.0.1:8787/go-go-goal
